# Stripe
STRIPE_SECRET_KEY=sk_test_your_test_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: use these if your deployment needs to accept both Dashboard and CLI/test endpoint secrets.
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_WEBHOOK_SECRET_TEST=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Yunik <kontakt@yunik.dk>
REPLY_TO_EMAIL=YunikJewelry@outlook.com
CONTACT_EMAIL=kontakt@yunik.dk

# Optional
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MAILCHIMP_URL=

# Set to "true" to redirect all public traffic to /coming-soon
# (admin, auth, and api routes remain accessible)
NEXT_PUBLIC_COMING_SOON=false
